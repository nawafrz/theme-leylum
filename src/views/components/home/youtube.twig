{#
| Variable    | Type   | Description                                                      |
| youtube_id  | string |                                                                  |
| position    | Int    | Sorting number start from zero                                   |
#}
{% set channel_vis = channel_visibility|default(component.channel_visibility|default(null)) %}
<section data-testid="store-home-youtube" class="s-block s-block--video mt-16 {{ channel_vis and not channel_vis.mobile ? 's-hide-on-mobile' : '' }} {{ channel_vis and not channel_vis.desktop ? 's-hide-on-desktop' : '' }}">
  <div class="container">
    <div class="videoWrapper">
      <lite-youtube videoid="{{ youtube_id }}" params="rel=0"></lite-youtube>
    </div>
  </div>
</section>
