{# ===== Leylum footer: three link columns, policy row, wordmark ===== #}
<footer data-testid="store-footer" class="store-footer ly-footer">
  <div class="ftr-top">
    <div class="ftr-cols">
      <div class="col">
        <h4>استكشف</h4>
        <a href="{{ link('/products') }}">تسوّق الكل</a>
        {% if theme.settings.get('footer_product_1_url') %}<a href="{{ theme.settings.get('footer_product_1_url') }}">{{ theme.settings.get('footer_product_1_label', 'مسحات التقشير اللطيف') }}</a>{% endif %}
        {% if theme.settings.get('footer_product_2_url') %}<a href="{{ theme.settings.get('footer_product_2_url') }}">{{ theme.settings.get('footer_product_2_label', 'كريم الإشراقة الفورية') }}</a>{% endif %}
      </div>
      <div class="col">
        <h4>خدمة العملاء</h4>
        {# Salla footer menu: the info pages the merchant added (contact, FAQ, shipping, returns…) #}
        <salla-menu data-testid="store-footer-menu" source="footer" with-cookie-preferences></salla-menu>
        <a href="{{ link('/customer/profile') }}">حسابي</a>
      </div>
      <div class="col">
        <h4>تابعنا</h4>
        {% if store.social.instagram %}<a href="{{ store.social.instagram }}" target="_blank" rel="noopener">إنستقرام</a>{% endif %}
        {% if store.social.tiktok %}<a href="{{ store.social.tiktok }}" target="_blank" rel="noopener">تيك توك</a>{% endif %}
        {% if store.social.snapchat %}<a href="{{ store.social.snapchat }}" target="_blank" rel="noopener">سناب شات</a>{% endif %}
        {% if store.social.twitter %}<a href="{{ store.social.twitter }}" target="_blank" rel="noopener">إكس</a>{% endif %}
        {% if store.contacts.whatsapp %}<a href="https://wa.me/{{ store.contacts.whatsapp|replace({'+':'', ' ':''}) }}" target="_blank" rel="noopener">واتساب</a>{% endif %}
        {% if store.contacts.email %}<a href="mailto:{{ store.contacts.email }}">{{ store.contacts.email }}</a>{% endif %}
      </div>
    </div>
  </div>

  <div class="ftr-bot">
    <div class="lf">
      <span>© {{ store.name }} {{ "now"|date("Y") }}</span>
    </div>
    <div class="mid"><img src="{{ store.logo|cdn(360) }}" alt="{{ store.name }}" class="ftr-logo"></div>
    <div class="rt">صُنع بعناية في الرياض</div>
  </div>

  <div class="ly-ftr-salla">
    <div class="wrap">
      <salla-payments data-testid="store-footer-payments"></salla-payments>
      <div class="ly-ftr-trust">
        <salla-trust-badges data-testid="store-footer-trust-badges"></salla-trust-badges>
        {% if store.settings.tax.number %}<span class="ly-tax">{{ trans('common.elements.tax_number') }}: {{ store.settings.tax.number }}</span>{% endif %}
      </div>
      <span class="ly-copy">{% hook copyright %}</span>
    </div>
  </div>
</footer>
