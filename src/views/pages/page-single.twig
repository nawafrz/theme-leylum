{#
| Variable     | Type                  | Description |
|--------------|-----------------------|-------------|
| page         | Page                  |             |
| page.title   | string                |             |
| page.content | string                |             |
| page.type    | string                |             |
#}
{% extends "layouts.master" %}
{% block content %}
  {% if page.type == 'customised' %}
    <div class="s-blocks-wrapper s-information-page !mt-0">{% hook 'information_page.information_page' %}</div>
  {% else %}
    <div class="wrap pgpad">
      <div class="legal ly-page">
        <h1>{{ page.title }}</h1>
        <div class="content-entry article">{{ page.content|raw }}</div>
        <salla-comments data-testid="store-page-comments" item-id="{{ page.id }}" type="page"></salla-comments>
      </div>
    </div>
  {% endif %}
{% endblock %}
