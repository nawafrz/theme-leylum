{#
| Variable                     | Type    | Description                                                      |
|------------------------------|---------|------------------------------------------------------------------|
| product                      | Product | see Raed's single.twig for the full list                          |
| product.id / name / url      |         |                                                                  |
| product.images[]             | array   | url, alt, id                                                     |
| product.price / sale_price   | float   |                                                                  |
| product.description          | string  | HTML                                                             |
#}
{% extends "layouts.master" %}
{% block content %}

{# ---- resolve the Leylum content block for this product (id first, then name) ---- #}
{% set lyKey = LY_IDS[product.id ~ ''] ?? null %}
{% if not lyKey %}
  {% if 'مسحات' in product.name %}{% set lyKey = 'pads' %}
  {% elseif 'كريم' in product.name %}{% set lyKey = 'cream' %}
  {% elseif 'مجموعة' in product.name %}{% set lyKey = 'bundle' %}{% endif %}
{% endif %}
{% set ly = lyKey ? LY[lyKey] : null %}

<div class="s-blocks-wrapper s-before-product-info !mt-0">{% hook 'product.single.before_product_info' %}</div>

<div class="wrap pgpad"><div class="pdp-top" id="product-{{ product.id }}">

  {# ===== Gallery (Salla slider keeps lightbox / video / thumbs behaviour) ===== #}
  <div class="pdp-gal">
    {% set has_many_images = product.images|length > 1 %}
    <salla-slider data-testid="store-product-image-slider" id="details-slider-{{ product.id }}" class="details-slider image-slider ly-gal"
                  type="thumbs" loop="false" auto-height listen-to-thumbnails-option show-thumbs-controls="false">
      {% if product.promotion_title %}<div class="promotion-title">{{ product.promotion_title }}</div>{% endif %}
      <div slot="items">
        {% for image in product.images %}
          <a data-fslightbox="product_{{ product.id }}" data-img-id="{{ image.id }}" data-slid-index="{{ loop.index-1 }}"
             {% if image.video_url %}data-video-src="{{ image.video_url }}"{% endif %}
             data-caption="{{ image.alt }}" data-infinite="false" data-type="{{ image.video_type ?? 'image' }}"
             href="{{ (image.video_url is iterable ? image.video_url|first : image.video_url)|default(image.url) }}"
             aria-label="{{ product.name }}" class="swiper-slide magnify-wrapper homeslider__slide {{ image.video_url ? 'video-entry' : '' }}">
            <img id="{{ image.id }}" src="{{ image.url }}" alt="{{ image.alt }}" {{ loop.first ? 'fetchpriority="high" loading="eager"' : 'loading="lazy"' }} class="w-full h-full object-cover">
          </a>
        {% endfor %}
      </div>
      {% if has_many_images %}
        <div data-testid="store-product-thumbnails" slot="thumbs" class="thumbs">
          {% for image in product.images %}
            <div class="slide--one-fourth {{ image.video_url ? 'video-entry' : '' }}" data-caption="{{ image.alt }}">
              <img src="{{ image.url }}" loading="{{ loop.index < 5 ? 'eager' : 'lazy' }}" class="object-cover w-full h-full" alt="{{ image.alt }}"/>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </salla-slider>
  </div>

  {# ===== Buy column ===== #}
  <div class="pdp-buy">
    {% hook 'product:single.description.start' %}
    {% if ly and ly.tag %}<div class="tagrow"><span class="tg">{{ ly.tag }}</span></div>{% endif %}
    <h1 data-testid="store-product-title">{{ product.name }}</h1>
    <p class="sub">{{ ly ? ly.sub : product.subtitle }}</p>

    <div class="prow" data-testid="store-product-price">
      {% if product.is_on_sale %}
        <span class="price">{{ product.sale_price|money }}</span><span class="was">{{ product.regular_price|money }}</span>
      {% else %}
        {% set showPrice = product.starting_price ?: product.price %}
        <span class="price">{{ showPrice|money }}</span>
      {% endif %}
    </div>
    <div class="vat">{% if product.is_taxable %}{{ trans('pages.products.tax_included') }} · {% endif %}{{ ly ? ly.size : '' }}</div>

    {% if product.rating %}<salla-rating-stars data-testid="store-product-rating" value="{{ product.rating.stars }}" reviews="{{ product.rating.count }}"></salla-rating-stars>{% endif %}

    {% if product.digital_files_settings %}<digital-files-settings settings='{{ product.digital_files_settings|json_encode }}'></digital-files-settings>{% endif %}

    <form data-testid="store-product-form" class="form product-form ly-form" enctype="multipart/form-data" method="post" onsubmit="return salla.form.onSubmit('cart.addItem', event)">
      <input type="hidden" name="id" value="{{ product.id }}">
      {% hook 'product:single.form.start' %}
      {% include 'pages.partials.product.options' %}
      {% hook 'product:single.form.end' %}

      {% if product.has_preorder_campaign %}
        <section class="ly-preorder"><salla-count-down data-testid="store-product-preorder-countdown" pre-order='{{ product.preorder|json_encode }}' boxed labeled></salla-count-down></section>
      {% endif %}

      <div class="pdp-qty sticky-product-bar">
        {% if product.is_hidden_quantity or product.type == 'booking' %}
          <input type="hidden" value="1" name="quantity" aria-label="Quantity"/>
        {% else %}
          <salla-quantity-input data-testid="store-product-quantity" max="{{ product.max_quantity }}" value="1" name="quantity" aria-label="Quantity" class="box"></salla-quantity-input>
        {% endif %}
        <salla-add-product-button data-testid="store-product-add-to-cart"
            {{ product.can_quick_buy ? 'quick-buy' : '' }}
            {{ theme.settings.get('sticky_add_to_cart') ? ' support-sticky-bar' : '' }}
            {{ product.is_require_shipping ? 'required-shipping' : '' }}
            {{ product.has_preorder_campaign ? 'has-pre-order' : '' }}
            amount="{{ product.base_currency_price }}"
            class="btn btn-block sticky-product-bar__btn ly-add {{ lyKey ? 'ly-add-' ~ lyKey : '' }}"
            product-status="{{ product.status }}" product-type="{{ product.type }}" product-id="{{ product.id }}"
            loader-position="end" type="submit" width="wide"
            {% if product.notify_availability %}
              {{ product.notify_availability.subscribed ? 'is-subscribed' : '' }}
              channels="{{ product.notify_availability.channels|join(',') }}"
              subscribed-options="{{ product.notify_availability.subscribed_options|json_encode }}"
              {{ product.notify_availability.options ? 'notify-options-availability' : '' }}
            {% endif %}>
          {{ product.add_to_cart_label }}
        </salla-add-product-button>
      </div>
      <div data-testid="store-product-out-of-stock" class="out-of-stock hidden">{{ trans('pages.products.out_of_stock') }}</div>
      {% if product.is_giftable %}
        <salla-gifting data-testid="store-product-gifting" class="mt-5" product-id="{{ product.id }}" {{ product.is_require_shipping ? 'physical-products' : '' }}></salla-gifting>
      {% endif %}
    </form>

    {% if ly %}
      <ul class="pdp-perks">{% for x in ly.perks %}<li><span class="tick">✓</span><span>{{ x }}</span></li>{% endfor %}</ul>
      <div class="pdp-acc">
        {% for f in ly.faq %}<details><summary>{{ f[0] }}</summary><div class="c">{{ f[1] }}</div></details>{% endfor %}
        {% if product.description %}<details><summary>الوصف</summary><div class="c article">{{ product.description|raw }}</div></details>{% endif %}
      </div>
    {% else %}
      <div data-testid="store-product-description" class="pdp-desc article">{{ product.description|replace({"&nbsp;":"\n"})|raw }}</div>
    {% endif %}

    <div class="ly-pdp-meta">
      {% if product.sku %}<span class="ly-sku">{{ trans('pages.products.sku') }}: <span class="text-unicode">{{ product.sku }}</span></span>{% endif %}
      <salla-social-share data-testid="store-product-social-share" class="ly-share" aria-label="social share"></salla-social-share>
    </div>
    <salla-installment data-testid="store-product-installment" price="{{ product.price }}"></salla-installment>
    {% if product.has_metadata %}<salla-metadata data-testid="store-product-metadata"></salla-metadata>{% endif %}
    {% hook 'product:single.description' %}
    {% hook 'product:single.description.end' %}
    <salla-quick-order data-testid="store-product-quick-order" class="mt-5 block"></salla-quick-order>
  </div>
</div></div>
<salla-offer data-testid="store-product-offer"></salla-offer>

{% if ly %}
  {# ===== How to use ===== #}
  <div class="wrap"><section class="how"><div class="panel">
    <h2>{{ ly.howHead|raw }}</h2>
    <div class="g">
      {% for s in ly.how %}
        <div class="c" style="background-image:url('{{ s.img|asset }}')"><div class="ov"><div class="t"><b>{{ s.t }}</b><i>{{ s.n }}</i></div><p>{{ s.b }}</p></div></div>
      {% endfor %}
    </div>
  </div></section></div>

  {# ===== Key ingredients ===== #}
  <section class="ing"><div class="g">
    <div class="col">
      <div class="eyebrow" style="margin-bottom:26px">المكونات الأساسية</div>
      {% for x in ly.ing %}
        <label class="opt"><input type="radio" name="ing-{{ lyKey }}" {{ loop.first ? 'checked' : '' }}><span class="nm">{{ x[0] }}</span><span class="bl">{{ x[1] }}</span></label>
      {% endfor %}
    </div>
    <div class="col mid">
      {% if ly.badgeKey %}<div class="badge badge-svg" style="background:none">{{ LY_ICON[ly.badgeKey]|raw }}</div>
      {% else %}<div class="badge" style="background:var(--ink)">AHA<br>PDRN</div>{% endif %}
    </div>
    <div class="col pic" style="background-image:url('{{ ly.ingPic|asset }}')"></div>
  </div></section>

  {# ===== Clinical results — rounded pattern card ===== #}
  <section class="tband tb-{{ lyKey }}"><div class="wrap"><div class="tcard g">
    <div>
      <div class="eyebrow" style="margin-bottom:14px">النتائج السريرية</div>
      <h2>نتائج تتحدث <span class="ac">عن نفسها.</span></h2>
      <div class="fn">{{ ly.fn }}</div>
    </div>
    <div class="box">
      {% for s in ly.stats %}<div class="r"><div class="n">{{ s[0] }}</div><div class="t">{{ s[1] }}</div></div>{% endfor %}
    </div>
  </div></div></section>

  {# ===== Cross-sell ===== #}
  {% set crossIds = [] %}
  {% if lyKey != 'cream' %}{% set crossIds = crossIds|merge([LY.cream.pid]) %}{% endif %}
  {% if lyKey != 'bundle' %}{% set crossIds = crossIds|merge([LY.bundle.pid]) %}{% endif %}
  {% if lyKey != 'pads' %}{% set crossIds = crossIds|merge([LY.pads.pid]) %}{% endif %}
  <div class="wrap">
    <div class="sec-head"><h2>{{ ly.crossHead|raw }}</h2><p class="lede">تركيبتان تكمّلان بعضهما — خطوتان ونتيجة واحدة.</p></div>
    <salla-products-list data-testid="store-product-related" class="pcards ly-cards" source="selected" source-value="[{{ crossIds|join(',') }}]" limit="2" product-card-component="leylum-product-card"></salla-products-list>
  </div>

  {% if ly.spf %}
    <div class="wrap"><section class="spf"><div class="bar"><span class="i">!</span><span>الأحماض تزيد حساسية البشرة للشمس. استخدم واقي شمس SPF 30–50 يوميًا — يحمي نتائجك ويمنع ظهور البقع الداكنة.</span></div></section></div>
  {% endif %}
  {% if ly.verdict %}
    <div class="wrap"><section class="verdict"><div class="g"><div class="eyebrow">{{ ly.verdict[0] }}</div><p>{{ ly.verdict[1] }}</p></div></section></div>
  {% endif %}
{% else %}
  <div class="wrap"><salla-products-slider data-testid="store-product-related" source="related" source-value="{{ product.id }}" block-title="{{ trans('pages.products.similar_products') }}" display-all-url></salla-products-slider></div>
{% endif %}

<div class="s-blocks-wrapper s-before-reviews">{% hook 'product.single.before_customer_reviews' %}</div>
{% if store.settings.rating.show_on_product %}
  <div class="wrap ly-comments"><salla-comments data-testid="store-product-comments" item-id="{{ product.id }}" type="product"></salla-comments></div>
{% endif %}
<div class="s-blocks-wrapper s-after-related">{% hook 'product.single.after_product_recommendations' %}</div>
{% endblock %}

{% block scripts %}
  <script defer src="{{ 'product.js' | asset }}"></script>
  {% if product.has_3d_image %}<script type="module" defer src="https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js"></script>{% endif %}
  {% if product.digital_files_settings %}<script type="module" defer src="{{ 'digital-files.js'|asset }}"></script>{% endif %}
{% endblock %}
