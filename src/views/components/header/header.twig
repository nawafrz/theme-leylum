{#
| Variable         | Type    | Description                     |
|------------------|---------|---------------------------------|
| cart             | object  |                                 |
| cart.items_count | int     |                                 |
| cart.total       | string  | Formatted total ex: "١٠٠ ر.س"   |
#}
{# ===== Leylum header: announcement strip + centred logo, nav on the start side, actions on the end side ===== #}
<header data-testid="store-header" class="store-header ly-header">
  <div class="lg:hidden"><salla-bullet-delivery-tag></salla-bullet-delivery-tag></div>

  {# Rotating announcement strip (texts editable from theme settings) #}
  <div class="announce" id="lyAnn"
       data-items="{{ [
         theme.settings.get('ann_1', 'شحن مجاني للطلبات فوق 200 ريال'),
         theme.settings.get('ann_2', 'ضمان أول استخدام — أو نعيد لك المبلغ'),
         theme.settings.get('ann_3', 'توصيل خلال 1–2 يوم عمل للرياض وجدة والدمام'),
         theme.settings.get('ann_4', 'إرجاع مجاني إذا لم يناسبك المنتج')
       ]|json_encode|e('html_attr') }}">
    <span id="annTxt">{{ theme.settings.get('ann_1', 'شحن مجاني للطلبات فوق 200 ريال') }}</span>
  </div>

  <div id="mainnav" class="main-nav-container ly-hdr">
    <div class="inner w-full">
      <div class="wrap">
        <div class="ly-hdr-row">

          {# START side (right in RTL): nav #}
          <div class="ly-hdr-nav">
            <a data-testid="store-header-mobile-toggle" class="lg:hidden mburger mburger--collapse burger" href="#mobile-menu" aria-label="Open-menu">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
            </a>
            <custom-main-menu class="hdr-nav"></custom-main-menu>
          </div>

          {# CENTRE: logo #}
          <a data-testid="store-header-logo" class="logo ly-logo" href="{{ store.url }}" aria-label="{{ store.name }}">
            <img fetchpriority="high" loading="eager" src="{{ store.logo|cdn(360) }}" alt="{{ store.name }} logo">
            {% if is_page('index') %}<h1 class="sr-only">{{ store.name }}</h1>{% else %}<h2 class="sr-only">{{ store.name }}</h2>{% endif %}
          </a>

          {# END side (left in RTL): actions #}
          <div class="hdr-act ly-hdr-act">
            {% if store.settings.is_multilingual or store.settings.currencies_enabled %}
              <salla-localization-modal data-testid="store-header-localization" show-trigger></salla-localization-modal>
            {% endif %}
            <salla-user-menu data-testid="store-header-user-menu" avatar-only show-header show-trigger class="ly-user"></salla-user-menu>
            <salla-cart-summary data-testid="store-header-cart" class="ly-cart">
              <svg slot="icon" class="ico" viewBox="0 0 24.64 32"><path fill="currentColor" d="M22.16,9.11h-3.5v-2.61C18.66,2.92,15.75,0,12.17,0S5.68,2.92,5.68,6.5v2.61h-3.2C1.11,9.11,0,10.22,0,11.59v16.16c0,2.35,1.91,4.25,4.25,4.25h16.14c2.35,0,4.25-1.91,4.25-4.25V11.59c0-1.37-1.11-2.48-2.48-2.48ZM8.19,6.5c0-2.19,1.79-3.98,3.98-3.98s3.98,1.79,3.98,3.98v2.61h-7.96v-2.61Z"/></svg>
            </salla-cart-summary>
          </div>

        </div>
      </div>
    </div>
  </div>
</header>
