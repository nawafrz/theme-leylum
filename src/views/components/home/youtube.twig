{#
| Variable    | Type   | Description                                                      |
| youtube_id  | string |                                                                  |
| position    | Int    | Sorting number start from zero                                   |
#}
<section data-testid="store-home-youtube" class="s-block s-block--video mt-16 {{ component.channel_visibility and not component.channel_visibility.mobile ? 's-hide-on-mobile' : '' }} {{ component.channel_visibility and not component.channel_visibility.desktop ? 's-hide-on-desktop' : '' }}">
  <div class="container">
    <div class="videoWrapper">
      <lite-youtube videoid="{{ youtube_id }}" params="rel=0"></lite-youtube>
    </div>
  </div>
</section>
