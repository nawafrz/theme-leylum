{#
| Variable        | Type       | Description                    |
|-----------------|------------|--------------------------------|
| products        | Products[] |                                |
| position        | Int        | Sorting number start from zero |
#}
{% set channel_vis = channel_visibility|default(component.channel_visibility|default(null)) %}
<section data-testid="store-home-products-section" class="s-block s-block--latest-products container mt-6 sm:mt-8 {{ channel_vis and not channel_vis.mobile ? 's-hide-on-mobile' : '' }} {{ channel_vis and not channel_vis.desktop ? 's-hide-on-desktop' : '' }}">
    <div class="s-block__title">
      <h2>{{ trans('blocks.home.latest_products') }}</h2>
    </div>
    
    <salla-products-list data-testid="store-home-latest-products-list" source="latest"></salla-products-list>
</section> 
