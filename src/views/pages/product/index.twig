{#
| Variable         | Type       | Description                                                         |
|------------------|------------|---------------------------------------------------------------------|
| page             | object     |                                                                     |
| page.title       | string     | *could be html                                                      |
| page.slug        | string     | ex: "product.index.category"                                        |
| page.id          | int        |                                                                     |
| filters          | ?array     |                                                                     |
| sort_options     | ?array     |                                                                     |
#}
{% extends "layouts.master" %}
{% block content %}
<div class="wrap pgpad">
  <div class="shop-head">
    <h1>{% if page.slug == 'product.index' %}العناية <span class="ac">بالبشرة</span>{% else %}{{ page.title|raw }}{% endif %}</h1>
    <p>ثلاثة خيارات، هدف واحد: نتيجة تراها من أول استخدام.</p>
  </div>

  {% if sort_options|length > 1 %}
  <div class="ly-sort">
    <label for="product-filter">{{ trans('pages.categories.sorting') }}</label>
    <select id="product-filter" class="form-input">
      {% for sort in sort_options %}<option value="{{ sort.id }}" {{ sort.is_selected ? 'selected' : '' }}>{{ sort.name }}</option>{% endfor %}
    </select>
  </div>
  {% endif %}

  {% hook 'product:index.items.start' %}
  <div class="ly-listing {{ filters ? 'has-filters' : '' }}">
    {% if filters %}
      <button class="btn--close-sm close-filters sicon-cancel hidden"></button>
      <salla-filters data-testid="store-products-filters" class="ly-filters" id="filters-menu"></salla-filters>
    {% endif %}
    <salla-products-list data-testid="store-products-list" class="pcards shop-grid ly-cards" source="{{ page.slug }}" source-value="{{ page.id }}" product-card-component="leylum-product-card" {{ filters ? 'filters-results' : '' }}></salla-products-list>
  </div>
  {% hook 'product:index.items.end' %}
</div>

<div class="s-blocks-wrapper s-after-products-list">{% hook 'product.index.after_products_group_with_filter' %}</div>

{% include 'pages.partials.leylum.clinical' with {prefix: 'clinShop'} %}
{% endblock %}

{% block scripts %}
  <script defer src="{{ 'product.js' | asset }}"></script>
{% endblock %}
